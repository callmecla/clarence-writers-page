# Get these from https://www.sanity.io/manage after creating a free project
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# The Sanity Studio (npm run sanity:dev) runs on a different system than
# your website and needs these same values under different variable names —
# just copy the same project ID and dataset from above into these two:
SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production

# Get this from https://resend.com/api-keys after creating a free account
RESEND_API_KEY=your-resend-api-key

# The email address that should receive messages from your contact form
# (this should be the same email you signed up to Resend with)
CONTACT_TO_EMAIL=you@example.com

# Get this from Sanity Manage > your project > API > Tokens (Editor permissions)
# Needed for the "leave a light" guestbook, which creates new documents
SANITY_API_TOKEN=your-write-token-here
